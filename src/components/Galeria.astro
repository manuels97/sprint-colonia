---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { SITE } from '../config/site';
import piletaJuego from '../assets/images/pileta-juego.png';
import plazaJuegos from '../assets/images/plaza-juegos.png';
import comedor from '../assets/images/comedor.png';
import hamacas from '../assets/images/hamacas.png';
import arboleda from '../assets/images/arboleda.png';
import canchaHockey from '../assets/images/cancha-hockey.png';

const fotos = [
  { src: piletaJuego, alt: 'Chicos jugando en la pileta del predio sobre una colchoneta de colores, con un profesor en el agua', caption: 'Las piletas', big: true },
  { src: plazaJuegos, alt: 'Juegos infantiles azules sobre el pasto, a la sombra de los árboles del predio', caption: 'Juegos para los más chicos' },
  { src: comedor, alt: 'Comedor del predio con mesas tendidas y paredes con cuadros y camisetas', caption: 'Comedor propio' },
  { src: hamacas, alt: 'Hamacas y tobogán sobre el pasto con las canchas al fondo', caption: 'Hamacas al aire libre' },
  { src: arboleda, alt: 'Hilera de árboles con bancos a la sombra junto a la cancha', caption: 'Sombra natural' },
];

const hasVideo = Boolean(SITE.video.youtubeId || SITE.video.file);
---

<section id="predio" class="section" aria-labelledby="predio-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Instalaciones</p>
      <h2 id="predio-title" class="section-title">Nuestro predio</h2>
      <p class="section-lead">
        Un espacio amplio, al aire libre y exclusivo para la colonia: tres piletas para distintas edades, mucho verde y
        zonas de juego pensadas para cada grupo.
      </p>
    </div>

    <ul class="gallery" role="list">
      {
        fotos.map((f, i) => (
          <li class:list={['gallery__item', { 'gallery__item--big': f.big }]} data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <figure>
              <Image
                src={f.src}
                alt={f.alt}
                widths={f.big ? [480, f.src.width] : [400, f.src.width]}
                sizes={f.big ? '(min-width: 960px) 600px, 100vw' : '(min-width: 960px) 300px, 50vw'}
                quality={75}
                loading="lazy"
              />
              <figcaption>{f.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <!-- Video del predio: facade liviano, el embed recién se carga al hacer clic -->
    <div class="video" data-reveal data-video data-youtube={SITE.video.youtubeId} data-file={SITE.video.file}>
      <Image
        src={canchaHockey}
        alt=""
        widths={[480, canchaHockey.width]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        quality={75}
        loading="lazy"
        class="video__poster"
      />
      <div class="video__shade"></div>
      {
        hasVideo ? (
          <button class="video__play" type="button" aria-label="Reproducir video del predio" data-video-play>
            <span class="video__btn">
              <Icon name="play" size={32} />
            </span>
            <span class="video__label">Recorré el predio en video</span>
          </button>
        ) : (
          <div class="video__play video__play--soon">
            <span class="video__btn" aria-hidden="true">
              <Icon name="play" size={32} />
            </span>
            <span class="video__label">
              Video del predio — próximamente <Placeholder label="video" />
            </span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .gallery__item--big { grid-column: span 2; }

  @media (min-width: 960px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 230px);
      gap: 1rem;
    }
    .gallery__item--big {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .gallery figure {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-sky-soft);
  }
  .gallery :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  @media (min-width: 960px) {
    .gallery :global(img) { aspect-ratio: auto; }
  }
  .gallery__item--big :global(img) { object-position: center 60%; }
  .gallery figure:hover :global(img) { transform: scale(1.04); }

  .gallery figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-night);
  }

  .video {
    position: relative;
    margin-top: 1rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-night);
  }
  @media (min-width: 960px) {
    .video { aspect-ratio: 21 / 9; margin-top: 1rem; }
  }
  .video__poster,
  .video :global(iframe),
  .video :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .video__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(27 42 51 / 0.7), rgb(27 42 51 / 0.2));
  }
  .video__play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    border: 0;
    background: none;
    color: var(--color-white);
    text-align: center;
    padding: 1rem;
  }
  .video__btn {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--color-sun);
    color: var(--color-night);
    box-shadow: 0 0 0 10px rgb(255 182 39 / 0.25);
    transition: transform 0.25s var(--ease-out);
  }
  button.video__play:hover .video__btn { transform: scale(1.08); }
  .video__play--soon .video__btn { opacity: 0.85; }
  .video__label {
    font-weight: 800;
    font-size: 1.1rem;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.35);
  }
  .video__label :global(.todo) { color: var(--color-sun); margin-left: 0.25rem; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-video-play]');
    if (!btn) return;
    btn.addEventListener(
      'click',
      () => {
        const { youtube, file } = box.dataset;
        let el: HTMLElement;
        if (youtube) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&rel=0&modestbranding=1`;
          iframe.title = 'Video del predio de Sprint Colonia';
          iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          el = iframe;
        } else {
          const video = document.createElement('video');
          video.src = file ?? '';
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          el = video;
        }
        box.querySelectorAll('.video__shade, [data-video-play]').forEach((n) => n.remove());
        box.append(el);
        el.focus();
      },
      { once: true },
    );
  });
</script>
