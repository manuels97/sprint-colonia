---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { SITE, waLink } from '../config/site';
import heroImg from '../assets/images/pool.jpg';

const trust = [
  { icon: 'award', label: '42 años de trayectoria' },
  { icon: 'shield', label: 'Predio exclusivo' },
  { icon: 'stethoscope', label: 'Servicio médico permanente' },
  { icon: 'waves', label: '3 piletas con guardavidas' },
] as const;
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Image
      src={heroImg}
      widths={[640, 1280, 1920, heroImg.width]}
      sizes="(max-aspect-ratio: 3/2) 150vh, 100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt="Vista aérea de una pileta con chicos nadando, reposeras rojas y una sombrilla a rayas en el borde"
      class="hero__img"
    />
    {
      SITE.heroVideo && (
        <video class="hero__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
          <source src={SITE.heroVideo} type="video/mp4" />
        </video>
      )
    }
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__kicker">Sprint Colonia · Colonia de verano en Núñez</span>
      <span class="hero__headline">42 años cuidando el verano de tus hijos</span>
    </h1>
    <p class="hero__sub">
      Un predio exclusivo, seguro y a un paso de tu casa, en Núñez{' '}
      {SITE.address.street ? `(${SITE.address.street})` : <Placeholder />}.
    </p>
    <div class="hero__ctas">
      <a class="btn btn--sun btn--lg" href={waLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Quiero más información
      </a>
      <a class="btn btn--outline-light btn--lg" href="#propuesta">
        Conocé la colonia <Icon name="arrow-right" />
      </a>
    </div>
  </div>

  <div class="container">
    <ul class="hero__trust" role="list">
      {
        trust.map((item) => (
          <li>
            <span class="icon-tile">
              <Icon name={item.icon} />
            </span>
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    /* Se mete debajo del header para que el video se vea a través de él */
    margin-top: calc(-1 * var(--header-h));
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(5rem, 14vh, 9rem));
  }
  @media (min-height: 1000px) {
    .hero { min-height: 860px; }
  }

  .hero__media {
    position: absolute;
    inset: 0 0 4.5rem 0;
    z-index: -1;
    overflow: hidden;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--color-sky-dark);
  }
  .hero__media :global(picture),
  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  /* Video apagado un poco para que no compita con el texto */
  .hero__video { filter: brightness(0.72) saturate(0.9); }

  /* Con movimiento reducido queda solo la foto */
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }

  /* Overlay suave: solo lo justo para leer el texto */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(27 42 51 / 0.15) 0%, rgb(27 42 51 / 0.35) 45%, rgb(27 42 51 / 0.78) 100%);
  }
  @media (min-width: 900px) {
    .hero__overlay {
      background:
        linear-gradient(90deg, rgb(20 40 52 / 0.78) 0%, rgb(20 40 52 / 0.5) 38%, rgb(20 40 52 / 0) 68%),
        linear-gradient(0deg, rgb(20 40 52 / 0.35) 0%, rgb(20 40 52 / 0) 35%);
    }
  }

  .hero__content {
    align-self: end;
    padding-bottom: 2.5rem;
    color: var(--color-white);
  }
  @media (min-width: 900px) {
    .hero__content { align-self: center; padding-bottom: 4rem; }
  }

  .hero__title { max-width: 36rem; font-weight: 400; }

  .hero__kicker {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.35);
    backdrop-filter: blur(6px);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .hero__headline {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 8vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
  }

  .hero__sub {
    max-width: 34rem;
    margin-top: 1.1rem;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600;
    line-height: 1.5;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.3);
  }
  .hero__sub :global(.todo) { color: var(--color-sun); }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  @media (max-width: 479px) {
    .hero__ctas .btn { width: 100%; }
  }

  .hero__trust {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem;
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .hero__trust .icon-tile { width: 42px; height: 42px; border-radius: 12px; }
  .hero__trust .icon-tile :global(svg) { width: 22px; height: 22px; }
  .hero__trust li:nth-child(2) .icon-tile { --tile-bg: var(--color-grass-soft); --tile-fg: var(--color-grass-dark); }
  .hero__trust li:nth-child(3) .icon-tile { --tile-bg: var(--color-sun-soft); --tile-fg: #B26F00; }

  @media (min-width: 900px) {
    .hero__trust {
      grid-template-columns: repeat(4, 1fr);
      padding: 1rem 1.25rem;
    }
    .hero__trust li { font-size: 1rem; }
  }
</style>
