---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Nosotros from '../components/Nosotros.astro';
import Propuesta from '../components/Propuesta.astro';
import Galeria from '../components/Galeria.astro';
import Actividades from '../components/Actividades.astro';
import Horarios from '../components/Horarios.astro';
import Servicios from '../components/Servicios.astro';
import Testimonios from '../components/Testimonios.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout>
  <Navbar />
  <main id="contenido">
    <Hero />
    <Nosotros />
    <Propuesta />
    <Galeria />
    <Actividades />
    <Horarios />
    <Servicios />
    <Testimonios />
    <Ubicacion />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
