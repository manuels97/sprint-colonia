---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { waLink } from '../config/site';
---

<Layout title="Página no encontrada | Sprint Colonia" noindex>
  <main id="contenido" class="notfound">
    <Logo height={64} />
    <h1 class="section-title">Esta página no existe</h1>
    <p>Puede que el link esté mal escrito o que la página se haya movido.</p>
    <div class="notfound__ctas">
      <a class="btn btn--sky" href="/">Volver al inicio</a>
      <a class="btn btn--outline" href={waLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Escribinos
      </a>
    </div>
  </main>
</Layout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.25rem;
    min-height: 100svh;
    padding: 2rem 1rem;
    text-align: center;
  }
  .notfound__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
